# =============================================================================
# .env.example — copy to .env and fill in. .env is gitignored, NEVER commit it.
# Per SECURITY_SETUP.md Layer 4: all config via env, no defaults for secrets.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# Camera source: integer index (0 = built-in MacBook cam) or an RTSP URL later.
CAMERA_SOURCE=0

# Compute device for PyTorch on Apple Silicon M3: mps | cpu
DEVICE=mps

# --- Models -----------------------------------------------------------------
# YOLO26 weight file (downloaded into ./models on first run; gitignored).
YOLO_MODEL=yolo26n.pt

# MediaPipe gesture model (downloaded into ./models; gitignored).
GESTURE_MODEL=gesture_recognizer.task

# --- Learning ---------------------------------------------------------------
# Min cosine similarity (0..1) to accept a few-shot match; below = "unknown".
RECOGNITION_THRESHOLD=0.75

# --- Privacy / Security -----------------------------------------------------
# Disable Ultralytics telemetry (analytics phone-home). Keep this true.
DISABLE_ULTRALYTICS_TELEMETRY=true

# Never auto-save frames. Frames are only persisted on explicit feedback.
PERSIST_FRAMES=false
